{
  "name": "songless-local",
  "version": "1.0.0",
  "description": "Un clone local de Songless / Heardle personnalisable",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "lan": "node server.js --lan",
    "dev": "node --watch server.js",
    "test": "npm run test:modes && npm run test:access && npm run test:answers && npm run test:suggestions && npm run test:rounds && npm run test:party && npm run test:results && npm run test:store && npm run test:player-http && npm run test:dupes && npm run test:ui && npm run test:http",
    "test:modes": "node scripts/audit-mode-registry.test.js",
    "test:access": "node scripts/audit-party-access.test.js",
    "test:answers": "node scripts/audit-party-answers.test.js",
    "test:suggestions": "node scripts/audit-party-suggestions.test.js",
    "test:rounds": "node scripts/audit-party-rounds.test.js",
    "test:party": "node scripts/audit-party.test.js",
    "test:results": "node scripts/audit-party-results.test.js",
    "test:store": "node scripts/audit-player-store.test.js",
    "test:player-http": "node scripts/audit-player-http.test.js",
    "test:dupes": "node scripts/audit-dupes.test.js",
    "test:ui": "node scripts/audit-static-ui.test.js",
    "test:http": "node scripts/audit-http.test.js"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "music-metadata": "^11.14.0",
    "qrcode": "^1.5.4"
  }
}
